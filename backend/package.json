{
  "name": "vendr-dashboard-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Proxy autenticado para a API do Vendr + servidor do dashboard",
  "main": "server.js",
  "bin": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "pkg . --targets node22-win-x64 --output ../dist/PainelVendr.exe"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ]
  }
}
